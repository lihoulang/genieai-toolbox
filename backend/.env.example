# ===========================================
# uni-ai-starter Backend Configuration
# Copy this file to .env and fill in your values
# ===========================================

# DeepSeek API (for reasoning/code tasks)
DS_API_KEY=your-deepseek-api-key-here
DS_API_URL=https://api.deepseek.com/chat/completions
DS_MODEL_NAME=deepseek-chat

# Qwen / DashScope API (for vision, text, image/video generation)
QWEN_API_KEY=your-dashscope-api-key-here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL_NAME=qwen-vl-max
QWEN_TEXT_MODEL=qwen-max

# Doubao / Volcano Engine API (for text chat)
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL_NAME=doubao-seed-1-6-lite-250615
DOUBAO_MODEL_ID_MAP={"doubao-seed-1-8-251228":"ep-20260113140843-nbf4d","doubao-seed-1-6-lite-251015":"ep-20260128151607-9qnld","doubao-1-5-lite-32k-250115":"ep-20260128151956-wllft"}

# Gemini API (use an OpenAI-compatible endpoint or proxy if needed)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_MODEL_NAME=gemini-2.5-flash

# Server
HOST=0.0.0.0
PORT=8000

# Database
DB_PATH=app.db

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=30

# Session
SESSION_TTL_DAYS=30

# CORS
# Use comma-separated HTTPS origins in production, for example:
# ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=*

# Membership / Google Play
FREE_PIN_LIMIT=3
VIP_PIN_LIMIT=20
MEMBERSHIP_CODE_MAP={"DEMO30":{"days":30,"level":1,"label":"月度会员"},"DEMO365":{"days":365,"level":2,"label":"年度会员"}}

# Google Play Billing
# Product keys can be `productId` or `productId:basePlanId`
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/absolute/path/to/google-play-service-account.json
# Or use inline JSON instead of file:
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_PLAY_SUBSCRIPTION_MAP={"genie.monthly":{"level":1,"label":"Google Play 月度会员"},"genie.yearly":{"level":2,"label":"Google Play 年度会员"}}
GOOGLE_PLAY_RTDN_BEARER_TOKEN=replace-with-long-random-token
